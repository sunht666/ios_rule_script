#!name=大管加超级管理员
#!desc=大管加超级管理员（完整权限：admin + 全模块权限码）
#!author=Sebastian

[Script]
# 签到请求 WiFi 和定位字段
erplus_sign = type=http-request,pattern=^https:\/\/www\.erplus\.co\/checkinWeb\/sign(?:\?.*)?$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_sign.js,requires-body=true,max-size=-1

# 域名修改
erplus_domain = type=http-response,pattern=^https?:\/\/www\.erplus\.cn\/getDomains$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_domain.js,requires-body=true,max-size=-1

# 管理员字段注入 (profile + identity)
erplus_profile = type=http-response,pattern=^https?:\/\/www\.erplus\.co\/api\/v1\/profile$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_admin.js,requires-body=true,max-size=-1
erplus_contacts = type=http-response,pattern=^https:\/\/www\.erplus\.co\/api\/v1\/contacts(?:\?.*)?$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_admin.js,requires-body=true,max-size=-1
erplus_identity = type=http-response,pattern=^https:\/\/www\.erplus\.co\/api\/v1\/contacts\/\d+\/identity$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_admin.js,requires-body=true,max-size=-1

# 权限码注入 (permissionCode数组 — 所有isXxxAdmin的数据源)
erplus_permission_someone = type=http-response,pattern=^https:\/\/www\.erplus\.co\/mpauth\/getSomeoneAuthByAccessToken$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_permission.js,requires-body=true,max-size=-1
erplus_permission_everyone = type=http-response,pattern=^https:\/\/www\.erplus\.co\/mpauth\/getEveryoneAuthByAccessTokenServlet$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_permission.js,requires-body=true,max-size=-1

# 调休余额修改
erplus_leave_template = type=http-response,pattern=^https:\/\/www\.erplus\.co\/appreq\/getTemplateLeaveType\?,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_leave.js,requires-body=true,max-size=-1
erplus_leave_list = type=http-response,pattern=^https:\/\/www\.erplus\.co\/appreq\/getTemplateList(?:\?.*)?$,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/erplus/erplus_leave.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% *.erplus.co, *.erplus.cn
