#!name=小红书语音开关
#!desc=小红书语音开关 Cold Start Config，开启语音评论
#!author=Sebastian

[Script]
xhs_voice = type=http-response,pattern=^https:\/\/.+\.xiaohongshu\.com\/api\/sns\/v1\/system\/cold_start_config,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/xhs/xhs_voice.js,requires-body=true,max-size=-1
xhs_save = type=http-response,pattern=^https:\/\/.+\.xiaohongshu\.com\/api\/sns\/v1\/note\/imagefeed,script-path=https://raw.githubusercontent.com/sunht666/ios_rule_script/master/script/sebastian/surge/xhs/xhs_save.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, *.xiaohongshu.com
